{
  "name": "ImportedFile",
  "type": "object",
  "properties": {
    "repo_full_name": {
      "type": "string",
      "description": "Owner/repo of the source repository"
    },
    "path": {
      "type": "string",
      "description": "Full path of the file within the repo"
    },
    "name": {
      "type": "string",
      "description": "File name"
    },
    "content": {
      "type": "string",
      "description": "Text content of the file"
    },
    "size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "sha": {
      "type": "string",
      "description": "Git blob SHA"
    }
  },
  "required": [
    "repo_full_name",
    "path",
    "name"
  ]
}